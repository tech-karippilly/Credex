NODE_ENV=development
PORT=3000

# Database name is the path of this URI. A MONGODB_URI already set in the
# process environment overrides this file. Do not point this at a different
# database than the one the running API uses.
MONGODB_URI=

JWT_SECRET=
JWT_EXPIRES_IN=15m

JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

ADMIN_EMAIL=
ADMIN_PASSWORD=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RESEND_API_KEY=
RESEND_FROM_EMAIL=

GEMINI_API_KEY=
GEMINI_MODEL=

FRONTEND_URL=

PASSWORD_RESET_EXPIRES_IN=15m
